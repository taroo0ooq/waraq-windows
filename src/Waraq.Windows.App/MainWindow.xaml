<Window
    x:Class="Waraq.Windows.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Waraq Settings"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <!-- Phase 8: Settings shell ~190dip sidebar, Mica, a11y names (DESIGN.md) -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          AutomationProperties.Name="Waraq Settings root">
        <NavigationView
            x:Name="NavView"
            AutomationProperties.Name="Settings navigation"
            AutomationProperties.LandmarkType="Navigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="190"
            CompactPaneLength="48"
            IsPaneToggleButtonVisible="True"
            PaneDisplayMode="Left"
            IsTabStop="True"
            TabNavigation="Cycle"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.PaneFooter>
                <Grid Padding="12,10"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="0,1,0,0"
                      AutomationProperties.Name="Advanced mode footer">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Advanced" FontWeight="SemiBold" FontSize="12"
                                   AutomationProperties.Name="Advanced mode label"/>
                        <TextBlock Text="Full depth controls" FontSize="10" Opacity="0.7"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="AdvancedToggle"
                                  Grid.Column="1"
                                  OffContent=""
                                  OnContent=""
                                  MinWidth="0"
                                  AutomationProperties.Name="Advanced mode"
                                  AutomationProperties.HelpText="Show Diagnostics and full-depth controls"
                                  Toggled="AdvancedToggle_Toggled"/>
                </Grid>
            </NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Frame x:Name="ContentFrame"
                       Grid.Row="0"
                       AutomationProperties.Name="Settings content"
                       AutomationProperties.LandmarkType="Main"
                       IsTabStop="False"/>

                <Border Grid.Row="1"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="28,8,28,12"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FooterStatus"
                                   Grid.Column="0"
                                   FontSize="11"
                                   Opacity="0.75"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="Status"/>
                        <Border x:Name="DpiBadge"
                                Grid.Column="1"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4"
                                Padding="8,3"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="DPI badge">
                            <TextBlock x:Name="DpiBadgeText"
                                       Style="{StaticResource WaraqStatusPillTextStyle}"
                                       Opacity="0.9"
                                       Text="DPI"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
