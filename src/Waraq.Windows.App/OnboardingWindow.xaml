<Window
    x:Class="Waraq.Windows.App.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Welcome to Waraq">

    <Grid Padding="32" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StepTitle" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="StepBody" Grid.Row="1" Margin="0,16,0,0" TextWrapping="Wrap" FontSize="14" Opacity="0.9"/>
        <TextBlock x:Name="StepIndicator" Grid.Row="2" Margin="0,12,0,0" FontSize="12" Opacity="0.7"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button x:Name="BackButton" Content="Back" Click="OnBack"/>
            <Button x:Name="NextButton" Content="Next" Click="OnNext" Style="{StaticResource AccentButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
