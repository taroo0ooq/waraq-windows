<UserControl
    x:Class="Waraq.Windows.App.Views.GeneralPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="General settings pane">

    <ScrollViewer Padding="{StaticResource WaraqContentPadding}">
        <StackPanel MaxWidth="720">
            <TextBlock Style="{StaticResource WaraqPaneTitleTextStyle}" Text="General"
                       AutomationProperties.Name="General heading"/>
            <TextBlock Style="{StaticResource WaraqHelperTextStyle}"
                       Text="Startup preferences and setup. Dark and light follow Windows theme automatically."/>

            <Border Style="{StaticResource WaraqCardBorderStyle}"
                    AutomationProperties.Name="Product status card">
                <TextBlock x:Name="StatusLine" TextWrapping="Wrap"/>
            </Border>

            <TextBlock Style="{StaticResource WaraqSectionHeaderTextStyle}" Text="SETUP"/>
            <Border Style="{StaticResource WaraqCardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Run the first-run wizard again anytime." TextWrapping="Wrap"/>
                    <Button Content="Run setup wizard again…"
                            Style="{StaticResource WaraqSecondaryButtonStyle}"
                            Click="OnRerunOnboarding"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Run setup wizard again"/>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,8,0,0" Style="{StaticResource WaraqHelperTextStyle}"
                       Text="Onboarding flag is local only under %AppData%\Waraq\onboarding.json. Zero telemetry."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
