<Window x:Class="Waraq.Windows.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Waraq for Windows"
        Height="420"
        Width="560"
        MinHeight="360"
        MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="#FF121212">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="ProductTitle"
                   Grid.Row="0"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#FFF5F5F5"
                   Text="Waraq for Windows"/>

        <TextBlock x:Name="VersionText"
                   Grid.Row="1"
                   Margin="0,8,0,0"
                   Foreground="#FFB0B0B0"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" Foreground="#FFE0E0E0" TextWrapping="Wrap"/>
            <TextBlock x:Name="StrategyText" Margin="0,8,0,0" Foreground="#FF9E9E9E" TextWrapping="Wrap"/>
            <TextBlock x:Name="UpstreamText" Margin="0,8,0,0" Foreground="#FF757575" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock x:Name="RepoText" Margin="0,4,0,0" Foreground="#FF757575" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="3"
                Margin="0,20,0,0"
                Padding="12"
                Background="#FF1E1E1E"
                CornerRadius="6"
                BorderBrush="#FF333333"
                BorderThickness="1">
            <TextBlock x:Name="ProbeResultText"
                       Foreground="#FFCFCFCF"
                       TextWrapping="Wrap"
                       Text="Click Probe desktop host to locate Progman/WorkerW without attaching a wallpaper surface."/>
        </Border>

        <Button Grid.Row="4"
                Margin="0,16,0,0"
                Padding="16,8"
                HorizontalAlignment="Left"
                Content="Probe desktop host"
                Click="OnProbeClick"/>
    </Grid>
</Window>
